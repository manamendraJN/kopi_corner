---
/**
 * SCENE 4 — The offer. (The signature moment.)
 * Steam rises off the full cup, drifts up to the chalkboard and flattens into chalk,
 * writing the day's menu line by line. Prices are [placeholders].
 */
import Cup from './Cup.astro';
import { offer, boardLines } from '../content/site';
---

<section class="offer" id="todays-board" aria-labelledby="offer-title" data-scene="offer">
  <svg class="rim" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 80V52C180 30 330 8 520 8c170 0 260 26 420 26S1250 0 1440 18v62Z" style="fill:var(--color-roast-900)"></path>
  </svg>

  <div class="offer-track" data-offer-track>
    <div class="offer-stage wrap" data-offer-stage>
      <div class="counter-strip" aria-hidden="true"></div>
      <div class="offer-copy">
        <p class="kicker">The menu</p>
        <h2 id="offer-title" class="offer-title">{offer.title}</h2>
        <p class="offer-line">{offer.line}</p>
        <a href="/menu" class="link-arrow">
          See the full menu
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 10h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>

      <div class="board" data-board>
        <div class="board-surface">
          <p class="chalk board-heading">
            {offer.boardHeading}
            <span class="board-date">{offer.boardDate}</span>
          </p>
          <ul class="board-lines">
            {
              boardLines.map((l) => (
                <li class="board-line" data-line>
                  <span class="mask" data-mask>
                    <span class="mask-inner chalk" data-mask-inner>
                      <span class="item">{l.name}</span>
                      <span class="dots" aria-hidden="true" />
                      <span class="price">{l.price}</span>
                    </span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="offer-cup" data-offer-cup>
        <Cup uid="offer" />
        <span class="steam-origin" data-steam-origin aria-hidden="true"></span>
        <div class="wisps" aria-hidden="true">
          {
            boardLines.map(() => (
              <svg class="chalk-wisp" data-wisp viewBox="0 0 120 120" focusable="false">
                <path d="M60 112c-18-16 14-30-2-50S40 26 62 8" fill="none" stroke-linecap="round" />
              </svg>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .offer {
    position: relative;
    z-index: 3;
    background: var(--color-roast-900);
    color: var(--color-foam-100);
  }
  .rim {
    position: absolute;
    left: 0;
    bottom: calc(100% - 1px);
    width: 100%;
    height: clamp(28px, 5vw, 80px);
    display: block;
  }
  .offer-track {
    position: relative;
  }
  :global(html.motion) .offer-track {
    height: 230svh;
  }
  .offer-stage {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    grid-template-areas: 'copy' 'board' 'cup';
    gap: 1rem;
    min-height: max(100svh, 40rem);
    padding-top: calc(var(--spacing-header) + 1rem);
    padding-bottom: 0;
    z-index: 1;
  }
  :global(html.motion) .offer-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
  }
  @media (min-width: 900px) {
    .offer-stage {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
      grid-template-areas: 'board copy' 'board cup';
      column-gap: clamp(2rem, 5vw, 5rem);
      padding-top: calc(var(--spacing-header) + 2rem);
    }
  }

  .offer-copy {
    grid-area: copy;
    align-self: center;
  }
  .offer-copy .kicker {
    margin: 0 0 0.75rem;
    color: var(--color-gold-300);
  }
  .offer-title {
    margin: 0;
    font-size: clamp(2.1rem, 1.3rem + 3vw, 4.4rem);
    line-height: 1;
    color: var(--color-foam-50);
  }
  .offer-line {
    margin: 0.75rem 0 0.25rem;
    max-width: 30ch;
    color: var(--color-foam-200);
  }
  .link-arrow {
    color: var(--color-gold-300);
  }
  @media (max-width: 899px) {
    .offer-title {
      font-size: clamp(1.9rem, 1.2rem + 3.4vw, 2.6rem);
    }
    .offer-line {
      display: none;
    }
    .offer-copy {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: end;
      column-gap: 1rem;
    }
    .offer-copy .kicker,
    .offer-title {
      grid-column: 1;
    }
    .link-arrow {
      grid-column: 2;
      grid-row: 2;
    }
  }

  /* ---------- the chalkboard ---------- */
  .board {
    grid-area: board;
    position: relative;
    z-index: 1;
    padding: clamp(0.6rem, 1.2vw, 1rem);
    border-radius: 0.6rem;
    background: linear-gradient(135deg, var(--color-crema-500), var(--color-roast-600) 45%, var(--color-roast-700));
    box-shadow:
      var(--shadow-deep),
      inset 0 1px 0 color-mix(in oklab, var(--color-crema-300) 60%, transparent);
    align-self: stretch;
    margin-bottom: clamp(0.5rem, 3svh, 2rem);
    transform: rotate(-0.6deg);
  }
  @media (min-width: 900px) {
    .board {
      margin-bottom: 15svh;
    }
  }
  .board-surface {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(1rem, 3vh, 2.6rem) clamp(1rem, 3vw, 2.8rem);
    border-radius: 0.3rem;
    background:
      radial-gradient(40% 30% at 22% 30%, color-mix(in oklab, var(--color-chalk) 7%, transparent), transparent),
      radial-gradient(35% 25% at 78% 70%, color-mix(in oklab, var(--color-chalk) 5%, transparent), transparent),
      radial-gradient(60% 40% at 50% 100%, color-mix(in oklab, var(--color-chalk) 4%, transparent), transparent),
      var(--color-board);
    box-shadow: inset 0 0 0 1px var(--color-board-edge), inset 0 10px 30px color-mix(in oklab, var(--color-board-edge) 80%, transparent);
    overflow: hidden;
  }
  .board-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0 0 clamp(0.5rem, 2.5vh, 1.6rem);
    font-size: clamp(1.7rem, 1rem + 2.8vh, 3rem);
    font-weight: 700;
    line-height: 1;
    border-bottom: 2px dashed color-mix(in oklab, var(--color-chalk) 35%, transparent);
    padding-bottom: clamp(0.4rem, 1.5vh, 1rem);
  }
  .board-date {
    font-size: 0.55em;
    font-weight: 500;
    opacity: 0.75;
  }
  .board-lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    flex: 1;
    gap: clamp(0.25rem, 1vh, 0.9rem);
  }
  .board-line {
    position: relative;
  }
  .mask {
    display: block;
    overflow: hidden;
  }
  .mask-inner {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: clamp(1.2rem, 0.65rem + 2.1vh, 2.1rem);
    line-height: 1.15;
    font-weight: 600;
  }
  .item {
    flex: 0 1 auto;
  }
  .dots {
    flex: 1 1 1rem;
    min-width: 1rem;
    border-bottom: 3px dotted color-mix(in oklab, var(--color-chalk) 45%, transparent);
    transform: translateY(-0.3em);
  }
  .price {
    flex: none;
    color: var(--color-gold-200);
    font-weight: 500;
  }
  @media (max-width: 639px) {
    .mask-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: 0.75rem;
      font-size: clamp(1.1rem, 0.6rem + 1.8vh, 1.45rem);
    }
    .dots {
      display: none;
    }
    .price {
      font-size: 0.85em;
    }
  }

  /* ---------- the cup and the counter it sits on ---------- */
  .offer-cup {
    grid-area: cup;
    position: relative;
    z-index: 3;
    justify-self: center;
    width: min(38vw, 17svh * 1.2);
    margin-bottom: 1.5svh;
  }
  @media (min-width: 900px) {
    .offer-cup {
      width: min(22vw, 34svh);
      justify-self: start;
      margin-bottom: 4svh;
    }
  }
  .steam-origin {
    position: absolute;
    left: 50%;
    top: 22%;
    width: 1px;
    height: 1px;
  }
  .wisps {
    display: none;
  }
  .counter-strip {
    position: absolute;
    left: calc(50% - 50vw);
    width: 100vw;
    bottom: 0;
    height: clamp(5rem, 13svh, 9rem);
    z-index: 0;
    background:
      linear-gradient(to bottom, var(--color-crema-500) 0, var(--color-roast-600) 14%, var(--color-roast-700) 15%, var(--color-roast-950) 100%);
  }
  :global(html.motion) .wisps {
    display: block;
    position: absolute;
    left: 50%;
    top: 22%;
    width: 0;
    height: 0;
  }
  .chalk-wisp {
    position: absolute;
    left: -55px;
    top: -55px;
    width: 110px;
    height: 110px;
    opacity: 0;
    overflow: visible;
  }
  .chalk-wisp {
    filter: blur(2.5px);
    will-change: transform, opacity;
  }
  .chalk-wisp path {
    stroke: var(--color-chalk);
    stroke-width: 12;
  }
</style>
