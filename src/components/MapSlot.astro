---
/** Map: shows the Google Maps embed from site.ts, or a clearly labelled placeholder. */
import { business } from '../content/site';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['map-slot', className]} id="map">
  {
    business.mapEmbedUrl ? (
      <iframe
        src={business.mapEmbedUrl}
        title={`Map showing ${business.name}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      />
    ) : (
      <div class="ph" role="img" aria-label="Map placeholder: add your Google Maps embed link in src/content/site.ts">
        <div class="grid" aria-hidden="true" />
        <svg class="pin" viewBox="0 0 40 52" aria-hidden="true" focusable="false">
          <path d="M20 51C20 51 38 31 38 19A18 18 0 0 0 2 19c0 12 18 32 18 32Z" style="fill:var(--color-terra-500)" />
          <circle cx="20" cy="19" r="7" style="fill:var(--color-foam-50)" />
        </svg>
        <p class="ph-text">
          <span class="placeholder-tag">Map placeholder</span>
          <span>Add your Google Maps embed in <code>src/content/site.ts</code></span>
        </p>
      </div>
    )
  }
</div>

<style>
  .map-slot {
    position: relative;
    border-radius: var(--radius-soft);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-foam-200);
  }
  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--color-foam-100);
  }
  .grid {
    position: absolute;
    inset: -20%;
    transform: rotate(-12deg);
    background:
      linear-gradient(to right, transparent 46%, var(--color-foam-50) 46% 54%, transparent 54%) 0 0 / 9rem 100%,
      linear-gradient(to bottom, transparent 44%, var(--color-foam-50) 44% 56%, transparent 56%) 0 0 / 100% 7rem,
      var(--color-foam-200);
    opacity: 0.9;
  }
  .pin {
    position: relative;
    width: 2.6rem;
    margin-top: -3rem;
  }
  .ph-text {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    margin: 0;
    display: grid;
    justify-items: start;
    gap: 0.4rem;
    padding: 0.8rem 1rem;
    border-radius: 0.8rem;
    background: color-mix(in oklab, var(--color-foam-50) 92%, transparent);
    color: var(--color-roast-900);
    font-size: 0.9rem;
  }
  code {
    font-size: 0.85em;
  }
</style>
