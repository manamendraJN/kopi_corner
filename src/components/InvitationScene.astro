---
/**
 * SCENE 6 — The invitation: "See you tomorrow."
 * Rises over the previous scene in full morning amber, with hours, map and directions.
 */
import HoursSign from './HoursSign.astro';
import MapSlot from './MapSlot.astro';
import { invitation, business, whatsappHref } from '../content/site';
---

<section class="invite" id="see-you" aria-labelledby="invite-title" data-scene="invite">
  <div class="wrap invite-grid">
    <div class="invite-words">
      <h2 id="invite-title" class="invite-title">
        {
          invitation.title.map((t) => (
            <span class="line">
              <span class="word" data-word>{t}</span>
            </span>
          ))
        }
      </h2>
      <p class="invite-line">{invitation.line}</p>
      <div class="invite-actions">
        <a href={business.directionsUrl} class="btn btn-roast" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 22s7-7.5 7-13a7 7 0 0 0-14 0c0 5.5 7 13 7 13Z" fill="none" stroke="currentColor" stroke-width="2"></path><circle cx="12" cy="9" r="2.5" fill="currentColor"></circle></svg>
          {invitation.directions}
        </a>
        <a href={whatsappHref()} class="btn btn-ghost" target="_blank" rel="noopener">Order ahead</a>
      </div>
      <address class="invite-address">
        {business.address.map((l) => <span>{l}</span>)}
        <a href={business.phoneHref}>{business.phoneDisplay}</a>
      </address>
    </div>
    <HoursSign class="invite-sign" />
    <MapSlot class="invite-map" />
  </div>
</section>

<style>
  .invite {
    position: relative;
    z-index: 5;
    padding-block: clamp(4rem, 9vw, 8rem) clamp(5rem, 9vw, 8rem);
    background:
      radial-gradient(90% 70% at 85% 10%, var(--color-gold-300), transparent 70%),
      linear-gradient(160deg, var(--color-gold-400) 0%, var(--color-gold-500) 45%, var(--color-terra-400) 100%);
    color: var(--color-roast-950);
  }
  .invite-grid {
    display: grid;
    gap: 2.5rem;
  }
  .invite-title {
    margin: 0;
    font-size: clamp(3.6rem, 1.6rem + 9vw, 10rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
    font-weight: 520;
  }
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .line:last-child .word {
    font-style: italic;
  }
  .word {
    display: inline-block;
    will-change: transform;
  }
  .invite-line {
    margin: 1.2rem 0 0;
    font-size: var(--text-lead);
  }
  .invite-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }
  .invite-address {
    display: grid;
    margin-top: 1.6rem;
    font-style: normal;
  }
  .invite-address a {
    display: inline-flex;
    align-items: center;
    min-height: var(--spacing-tap);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .invite-grid > :global(.invite-map) {
    box-shadow: var(--shadow-deep);
  }

  @media (min-width: 900px) {
    .invite-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 2rem;
      row-gap: 2rem;
      align-items: start;
    }
    .invite-words {
      grid-column: 1 / 8;
      grid-row: 1 / 3;
    }
    .invite-grid > :global(.invite-sign) {
      grid-column: 9 / 13;
      grid-row: 1;
      justify-self: end;
      width: 100%;
    }
    .invite-grid > :global(.invite-map) {
      grid-column: 8 / 13;
      grid-row: 2;
      transform: rotate(1deg);
    }
  }
</style>
