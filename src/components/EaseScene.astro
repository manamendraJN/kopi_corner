---
/**
 * SCENE 5 — The ease: order at the counter, or WhatsApp ahead.
 * The example message "sends" as you arrive; the counter docket settles beside it.
 */
import { ease, whatsappHref } from '../content/site';
---

<section class="ease" id="order-ahead" aria-labelledby="ease-title" data-scene="ease">
  <svg class="rim" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 80V36C300 10 560 0 760 0s420 14 680 44v36Z" style="fill:var(--color-gold-200)"></path>
  </svg>
  <div class="ease-inner" data-ease-inner>
    <div class="wrap ease-grid">
      <header class="ease-head">
        <p class="kicker">The easy part</p>
        <h2 id="ease-title" class="ease-title">{ease.title}</h2>
        <p class="ease-line">{ease.line}</p>
      </header>

      <div class="way way-wa" data-wa>
        <p class="kicker way-kicker">{ease.whatsapp.kicker}</p>
        <h3 class="way-title">{ease.whatsapp.title}</h3>
        <p class="way-body">{ease.whatsapp.body}</p>
        <figure class="bubble-wrap" data-bubble>
          <span class="placeholder-tag">{ease.whatsapp.bubbleLabel}</span>
          <blockquote class="bubble">
            <p>{ease.whatsapp.bubble}</p>
            <span class="meta" aria-hidden="true">
              {ease.whatsapp.bubbleTime}
              <svg width="18" height="12" viewBox="0 0 18 12" focusable="false"><path d="M1 6.5 4.5 10 11 2.5M7.5 9.5 8 10l6.5-7.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
          </blockquote>
        </figure>
        <a href={whatsappHref()} class="btn btn-leaf wa-btn" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.6-2-1-1 .9a5 5 0 0 1-2.8-2.8l.9-1-1-2Z" fill="currentColor"></path></svg>
          {ease.whatsapp.button}
        </a>
      </div>

      <div class="way docket" data-docket>
        <p class="docket-no" aria-hidden="true">{ease.counter.docketNo}</p>
        <p class="kicker way-kicker">{ease.counter.kicker}</p>
        <h3 class="way-title">{ease.counter.title}</h3>
        <p class="way-body">{ease.counter.body}</p>
        <a href="/visit" class="link-arrow">
          {ease.counter.link}
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 10h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>
    </div>
    <div class="ease-shade" data-ease-shade aria-hidden="true"></div>
  </div>
</section>

<style>
  .ease {
    position: relative;
    z-index: 4;
    background: var(--color-gold-200);
    color: var(--color-roast-950);
  }
  .rim {
    position: absolute;
    left: 0;
    bottom: calc(100% - 1px);
    width: 100%;
    height: clamp(28px, 5vw, 80px);
    display: block;
  }
  .ease-inner {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5rem) var(--spacing-section);
  }
  .ease-shade {
    position: absolute;
    inset: 0;
    background: var(--color-roast-950);
    opacity: 0;
    pointer-events: none;
  }
  .ease-grid {
    display: grid;
    gap: 1.5rem;
  }
  .ease-head .kicker {
    margin: 0 0 0.75rem;
    color: var(--color-terra-600);
  }
  .ease-title {
    margin: 0;
    font-size: var(--text-display);
    line-height: 0.92;
  }
  .ease-line {
    margin: 1rem 0 0;
    font-size: var(--text-lead);
  }
  .way-kicker {
    margin: 0 0 0.4rem;
  }
  .way-title {
    margin: 0;
    font-size: clamp(1.7rem, 1.2rem + 1.6vw, 2.6rem);
    line-height: 1.05;
  }
  .way-body {
    margin: 0.6rem 0 0;
    max-width: 36ch;
  }

  .way-wa {
    position: relative;
    padding: clamp(1.4rem, 3vw, 2.6rem);
    border-radius: 1.6rem;
    background: var(--color-foam-50);
    box-shadow: var(--shadow-deep);
  }
  .way-wa .way-kicker {
    color: var(--color-leaf-700);
  }
  .bubble-wrap {
    margin: 1.4rem 0;
    display: grid;
    justify-items: end;
    gap: 0.5rem;
  }
  .bubble {
    position: relative;
    margin: 0;
    max-width: 26rem;
    padding: 0.8rem 1rem 0.55rem;
    border-radius: 1.1rem 1.1rem 0.25rem 1.1rem;
    background: color-mix(in oklab, var(--color-leaf-400) 30%, var(--color-foam-50));
    font-size: 1.05rem;
  }
  .bubble p {
    margin: 0;
  }
  .meta {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--color-dawn-700);
  }
  .wa-btn {
    width: 100%;
  }

  .docket {
    position: relative;
    padding: 2.2rem 1.4rem 1.6rem;
    background: var(--color-foam-50);
    transform: rotate(1.5deg);
    -webkit-mask: radial-gradient(circle at 50% 0, transparent 0.45rem, var(--color-white) 0.5rem) 0 0 / 1.4rem 100% repeat-x;
    mask: radial-gradient(circle at 50% 0, transparent 0.45rem, var(--color-white) 0.5rem) 0 0 / 1.4rem 100% repeat-x;
    border-bottom: 3px solid var(--color-terra-500);
  }
  .docket-no {
    position: absolute;
    right: 1.4rem;
    top: 1.2rem;
    margin: 0;
    font-family: var(--font-chalk);
    font-size: 1.4rem;
    color: var(--color-terra-600);
  }
  .docket .way-kicker {
    color: var(--color-terra-600);
  }
  .docket .link-arrow {
    margin-top: 0.4rem;
  }

  @media (min-width: 900px) {
    .ease-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto;
      column-gap: 2rem;
      row-gap: 3rem;
      align-items: start;
    }
    .ease-head {
      grid-column: 1 / 7;
      grid-row: 1;
    }
    .docket {
      grid-column: 1 / 6;
      grid-row: 2;
      margin-left: 2rem;
      transform: rotate(-2deg);
    }
    .way-wa {
      grid-column: 7 / 13;
      grid-row: 1 / 3;
      margin-top: 2rem;
    }
  }
</style>
