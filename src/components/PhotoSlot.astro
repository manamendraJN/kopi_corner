---
/**
 * A clearly labelled photo placeholder at the right size and shape.
 * Drop a real photo in later: import it from src/assets/photos and pass it as `src`
 * (Astro's <Image> will resize and compress it automatically).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label: string;
  ratio?: string; // e.g. "4 / 5"
  src?: ImageMetadata;
  alt?: string;
  tone?: 'foam' | 'roast' | 'kraft';
  class?: string;
  widths?: number[];
  sizes?: string;
}
const {
  label,
  ratio = '4 / 5',
  src,
  alt = label,
  tone = 'foam',
  class: className = '',
  widths = [480, 800, 1200],
  sizes = '(min-width: 900px) 40vw, 90vw',
} = Astro.props;
const ratioText = ratio.replace(/\s/g, '');
---

<figure class:list={['photo-slot', `tone-${tone}`, className]} style={`aspect-ratio:${ratio}`}>
  {
    src ? (
      <Image src={src} alt={alt} widths={widths} sizes={sizes} class="photo-img" />
    ) : (
      <div class="ph" role="img" aria-label={`Photo placeholder: ${label}`}>
        <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
          <path
            d="M4 8.5A2.5 2.5 0 0 1 6.5 6h1.7l1.3-2h5l1.3 2h1.7A2.5 2.5 0 0 1 20 8.5v8A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
          />
          <circle cx="12" cy="12.4" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6" />
        </svg>
        <span class="ph-tag">Photo placeholder</span>
        <span class="ph-label">{label}</span>
        <span class="ph-ratio">{ratioText}</span>
      </div>
    )
  }
</figure>

<style>
  .photo-slot {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-soft);
    isolation: isolate;
    container-type: inline-size;
  }
  .photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.4rem;
    padding: 1.25rem;
    text-align: center;
    background-image:
      repeating-linear-gradient(-45deg, transparent 0 14px, var(--stripe) 14px 15px),
      radial-gradient(120% 90% at 30% 20%, var(--hi), var(--base));
    color: var(--ink);
  }
  .ph::after {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1.5px dashed var(--stripe-strong);
    border-radius: calc(var(--radius-soft) - 8px);
    pointer-events: none;
  }
  .ph-tag {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .ph-label {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.25;
    max-width: 22ch;
  }
  .ph-ratio {
    font-size: 0.75rem;
    opacity: 0.65;
  }
  @container (max-width: 210px) {
    .ph {
      padding: 0.75rem;
      gap: 0.25rem;
    }
    .ph svg,
    .ph-ratio {
      display: none;
    }
    .ph-tag {
      font-size: 0.58rem;
    }
    .ph-label {
      font-size: 0.85rem;
    }
  }
  .tone-foam {
    --base: var(--color-foam-200);
    --hi: var(--color-foam-50);
    --ink: var(--color-roast-700);
    --stripe: color-mix(in oklab, var(--color-roast-500) 10%, transparent);
    --stripe-strong: color-mix(in oklab, var(--color-roast-500) 40%, transparent);
  }
  .tone-kraft {
    --base: var(--color-crema-400);
    --hi: var(--color-crema-300);
    --ink: var(--color-roast-900);
    --stripe: color-mix(in oklab, var(--color-roast-800) 10%, transparent);
    --stripe-strong: color-mix(in oklab, var(--color-roast-900) 40%, transparent);
  }
  .tone-roast {
    --base: var(--color-roast-800);
    --hi: var(--color-roast-600);
    --ink: var(--color-foam-100);
    --stripe: color-mix(in oklab, var(--color-foam-100) 8%, transparent);
    --stripe-strong: color-mix(in oklab, var(--color-foam-100) 35%, transparent);
  }
</style>
