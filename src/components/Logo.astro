---
/**
 * Kopi Corner mark: a tile with the morning sun rising from its corner,
 * and a corner bracket. Pure geometry, so it reads at 16px.
 * variant "light" = for light backgrounds, "dark" = for dark backgrounds.
 */
interface Props {
  variant?: 'light' | 'dark';
  showWordmark?: boolean;
  size?: number;
  class?: string;
}
const { variant = 'light', showWordmark = true, size = 34, class: className = '' } = Astro.props;
const tile = variant === 'light' ? 'var(--color-roast-800)' : 'var(--color-foam-100)';
const sun = variant === 'light' ? 'var(--color-gold-400)' : 'var(--color-terra-500)';
const corner = variant === 'light' ? 'var(--color-foam-100)' : 'var(--color-roast-800)';
---

<span class:list={['logo', className]} data-variant={variant}>
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="7" style={`fill:${tile}`}></rect>
    <path d="M6 26V11a15 15 0 0 1 15 15Z" style={`fill:${sun}`}></path>
    <path d="M17.5 6.5H25.5V14.5" fill="none" style={`stroke:${corner}`} stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  {showWordmark && <span class="logo-word">Kopi Corner</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo svg {
    flex: none;
  }
  .logo-word {
    font-family: var(--font-display);
    font-weight: 620;
    font-size: 1.28rem;
    letter-spacing: -0.025em;
    line-height: 1;
    white-space: nowrap;
  }
</style>
