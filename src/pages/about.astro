---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { pages, about, whatsappHref } from '../content/site';
---

<BaseLayout title={pages.about.title} description={pages.about.description}>
  <article class="about">
    <header class="wrap about-intro">
      <div>
        <p class="kicker">About Kopi Corner</p>
        <h1 class="about-title">{about.title}</h1>
      </div>
      <div class="about-copy">
        <p class="lead">{about.intro}</p>
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <PhotoSlot label="The cafe front in the morning" ratio="3 / 2" class="about-photo" tone="kraft" />
    </header>

    <section class="morning" aria-labelledby="morning-title" data-scene="morning">
      <div class="morning-pin" data-morning-pin>
        <div class="morning-sky" aria-hidden="true">
          <div class="morning-day"></div>
          <div class="morning-dawn" data-morning-dawn></div>
        </div>
        <div class="wrap morning-head">
          <h2 id="morning-title" class="morning-title">{about.morningTitle}</h2>
          <p>{about.morningLine}</p>
        </div>
        <ol class="strip" data-strip>
          {
            about.morning.map((m, i) => (
              <li class="hour">
                <p class="hour-time">{m.time}</p>
                <h3 class="hour-title">{m.title}</h3>
                <p class="hour-body">{m.body}</p>
                <span class="hour-n" aria-hidden="true">
                  0{i + 1}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="wrap people" aria-labelledby="people-title">
      <div class="people-text" data-reveal>
        <h2 id="people-title" class="people-title">{about.peopleTitle}</h2>
        <p class="lead">{about.peopleLine}</p>
        <div class="people-actions">
          <a href="/visit" class="btn btn-roast">Come and say hello</a>
          <a href={whatsappHref()} class="btn btn-ghost" target="_blank" rel="noopener">Order ahead</a>
        </div>
      </div>
      <div class="people-photos">
        <PhotoSlot label="The team behind the counter" ratio="4 / 5" class="pp-1" />
        <PhotoSlot label="Regulars at the window stools" ratio="1 / 1" class="pp-2" tone="kraft" />
        <PhotoSlot label="Hands shaping the morning bake" ratio="1 / 1" class="pp-3" tone="roast" />
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about {
    background: var(--color-foam-100);
  }
  .about-intro {
    display: grid;
    gap: 1.5rem;
    padding-top: calc(var(--spacing-header) + clamp(2rem, 6vw, 5rem));
    padding-bottom: var(--spacing-section);
  }
  .about-intro .kicker {
    margin: 0 0 1rem;
    color: var(--color-terra-600);
  }
  .about-title {
    margin: 0;
    font-size: var(--text-title);
    line-height: 1;
    max-width: 14ch;
  }
  .lead {
    font-size: var(--text-lead);
    font-family: var(--font-display);
    line-height: 1.35;
  }
  .about-copy p {
    max-width: 52ch;
  }
  @media (min-width: 900px) {
    .about-intro {
      grid-template-columns: 1.1fr 1fr;
      column-gap: 5rem;
      align-items: end;
    }
    .about-intro :global(.about-photo) {
      grid-column: 1 / -1;
      max-height: 70svh;
      width: 100%;
    }
  }

  /* ---------- a morning, hour by hour ---------- */
  .morning {
    position: relative;
    background: var(--color-dawn-900);
    color: var(--color-foam-50);
  }
  .morning-pin {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 8vw, 6rem);
  }
  .morning-sky,
  .morning-sky > div {
    position: absolute;
    inset: 0;
  }
  .morning-day {
    background: linear-gradient(160deg, var(--color-roast-800), var(--color-terra-600) 60%, var(--color-gold-500));
  }
  .morning-dawn {
    background: linear-gradient(160deg, var(--color-dawn-950), var(--color-dawn-700) 70%, var(--color-dawn-500));
  }
  :global(html:not(.motion)) .morning-dawn {
    opacity: 0;
  }
  .morning-head {
    position: relative;
  }
  .morning-title {
    margin: 0;
    font-size: var(--text-title);
    line-height: 1;
  }
  .morning-head p {
    margin: 0.75rem 0 0;
    font-size: var(--text-lead);
    opacity: 0.85;
  }
  .strip {
    position: relative;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0 var(--spacing-gutter);
    display: grid;
    gap: 1rem;
  }
  .hour {
    position: relative;
    padding: 1.4rem 1.4rem 1.6rem 3.4rem;
    border-radius: 1.2rem;
    background: color-mix(in oklab, var(--color-foam-50) 9%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-foam-50) 18%, transparent);
    overflow: hidden;
  }
  .hour::before {
    content: '';
    position: absolute;
    left: 1.4rem;
    top: 1.75rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-gold-300);
  }
  .hour-time {
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-gold-300);
  }
  .hour-title {
    margin: 0.3rem 0 0;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.4rem);
    line-height: 1.05;
  }
  .hour-body {
    margin: 0.5rem 0 0;
    max-width: 32ch;
    opacity: 0.88;
  }
  .hour-n {
    position: absolute;
    right: 1rem;
    bottom: -0.6rem;
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 1;
    opacity: 0.12;
  }
  @media (min-width: 640px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    :global(html.motion) .morning-pin {
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: calc(var(--spacing-header) + 2rem);
    }
    :global(html.motion) .strip {
      display: flex;
      gap: 1.5rem;
      width: max-content;
      padding-right: 12vw;
    }
    :global(html.motion) .hour {
      width: clamp(18rem, 26vw, 24rem);
      min-height: 22rem;
      padding: 2rem 2rem 3rem;
      display: flex;
      flex-direction: column;
    }
    :global(html.motion) .hour::before {
      display: none;
    }
    :global(html.motion) .hour-n {
      font-size: 7rem;
    }
    :global(html:not(.motion)) .strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------- people ---------- */
  .people {
    display: grid;
    gap: 2.5rem;
    padding-block: var(--spacing-section);
  }
  .people-title {
    margin: 0;
    font-size: var(--text-title);
    line-height: 1;
  }
  .people-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .people-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .people-photos :global(.pp-1) {
    grid-row: span 2;
  }
  @media (min-width: 900px) {
    .people {
      grid-template-columns: 1fr 1.2fr;
      column-gap: 5rem;
      align-items: center;
    }
    .people-photos :global(.pp-2) {
      transform: translateY(2.5rem);
    }
  }
</style>
